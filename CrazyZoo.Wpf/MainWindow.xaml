<Window x:Class="CrazyZoo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CrazyZoo.Wpf.ViewModels"
        Title="Crazy Zoo" Height="720" Width="1000">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Üks mall, mida kasutavad kõik looma-listid -->
        <DataTemplate x:Key="AnimalLineTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                <TextBlock Text=" ("/>
                <TextBlock Text="{Binding Species}"/>
                <TextBlock Text=") – energia "/>
                <TextBlock Text="{Binding Energy}"/>
                <TextBlock Text=", meeleolu "/>
                <TextBlock Text="{Binding Mood}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <TabControl Margin="5">
    <TabItem Header="Loomaaed">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Hoidla (loomatüüp):" FontWeight="Bold"/>
            <ComboBox ItemsSource="{Binding Sections}"
                      DisplayMemberPath="TypeName"
                      SelectedItem="{Binding SelectedSection}"/>

            <TextBlock Text="Loomad" FontWeight="Bold" Margin="0,10,0,0"/>
            <ListBox Height="220"
                     ItemsSource="{Binding Animals}"
                     SelectedItem="{Binding SelectedAnimal}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <TextBlock Text=" – "/>
                            <TextBlock Text="{Binding Species}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Nimi:" Margin="0,10,0,0"/>
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Lisa loom" Command="{Binding AddCommand}" Margin="0,8,0,0"/>
            <Button Content="Eemalda valitud" Command="{Binding RemoveCommand}" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding DetailsTitle}" FontSize="14" FontWeight="Bold"/>

            <TextBlock Text="Energia:" Margin="0,8,0,0"/>
            <ProgressBar Minimum="0" Maximum="100" Height="18" Value="{Binding SelectedEnergy, Mode=OneWay}"/>
            <TextBlock Text="Nälg:" Margin="0,5,0,0"/>
            <ProgressBar Minimum="0" Maximum="100" Height="18" Foreground="OrangeRed" Value="{Binding SelectedHunger, Mode=OneWay}"/>
            <TextBlock Text="Meeleolu:" Margin="0,5,0,0"/>
            <ProgressBar Minimum="0" Maximum="100" Height="18" Foreground="SeaGreen" Value="{Binding SelectedMood, Mode=OneWay}"/>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="Reageeritud kordi: "/>
                <TextBlock Text="{Binding SelectedReactionCount}" FontWeight="Bold"/>
            </StackPanel>

            <WrapPanel Margin="0,10,0,0">
                <TextBox Width="50" Margin="0,0,5,0"
                         Text="{Binding FoodAmountText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Söötmine" Command="{Binding EatCommand}" Margin="0,0,5,0"/>
                <Button Content="Puhka" Command="{Binding RestCommand}" Margin="0,0,5,0"/>
                <Button Content="Hääl" Command="{Binding SoundCommand}" Margin="0,0,5,0"/>
                <Button Content="CrazyAction!" Command="{Binding CrazyActionCommand}"/>
            </WrapPanel>

            <WrapPanel Margin="0,8,0,0">
                <Button Content="Ujuda" Command="{Binding SwimCommand}" Margin="0,0,5,0"/>
                <Button Content="Ronida" Command="{Binding ClimbCommand}" Margin="0,0,5,0"/>
                <Button Content="Lennata" Command="{Binding FlyCommand}"/>
            </WrapPanel>

            <!-- TabControl: logi ja kolm LINQ-päringut eraldi vahekaartidel -->
            <TabControl Height="330" Margin="0,12,0,0">
                <TabItem Header="Logi">
                    <ListBox ItemsSource="{Binding LogEntries}"/>
                </TabItem>

                <TabItem Header="Otsing (Where)">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                            <TextBlock Text="Nimi või liik: " VerticalAlignment="Center"/>
                            <TextBox Width="200"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding SearchResults}"
                                 ItemTemplate="{StaticResource AnimalLineTemplate}"/>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Energia järgi (OrderBy)">
                    <ListBox ItemsSource="{Binding SortedAnimals}"
                             ItemTemplate="{StaticResource AnimalLineTemplate}"/>
                </TabItem>

                <TabItem Header="Kokkuvõte (GroupBy)">
                    <ListBox ItemsSource="{Binding SpeciesSummary}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Species}" FontWeight="Bold"/>
                                    <TextBlock Text=": "/>
                                    <TextBlock Text="{Binding Count}"/>
                                    <TextBlock Text=" looma"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>
        </StackPanel>
    </Grid>
    </TabItem>

    <!-- Vol.3: ressursimahukas arvutus järjestikku ja paralleelselt -->
    <TabItem Header="Prognoos (Vol.3)" DataContext="{Binding Forecast}">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.8*"/>
            </Grid.ColumnDefinitions>

            <!-- Vasak pool: sisend -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="1. Hetktõmmis" FontWeight="Bold"/>
                <TextBlock Text="{Binding SnapshotText}" TextWrapping="Wrap"/>
                <Button Content="Tee uus hetktõmmis" Command="{Binding SnapshotCommand}" Margin="0,5,0,0"/>

                <TextBlock Text="2. Vali loomad" FontWeight="Bold" Margin="0,12,0,0"/>
                <ListBox ItemsSource="{Binding Choices}" Height="220">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <CheckBox IsChecked="{Binding IsSelected}" FontWeight="Bold">
                                    <TextBlock>
                                        <Run Text="{Binding Snapshot.Name, Mode=OneWay}"/>
                                        <Run Text="–"/>
                                        <Run Text="{Binding Snapshot.Species, Mode=OneWay}"/>
                                    </TextBlock>
                                </CheckBox>
                                <TextBlock Margin="20,0,0,0" Foreground="Gray">
                                    <Run Text="energia"/>
                                    <Run Text="{Binding Snapshot.Energy, Mode=OneWay}"/>
                                    <Run Text=", nälg"/>
                                    <Run Text="{Binding Snapshot.Hunger, Mode=OneWay}"/>
                                    <Run Text=", meeleolu"/>
                                    <Run Text="{Binding Snapshot.Mood, Mode=OneWay}"/>
                                </TextBlock>
                                <CheckBox IsChecked="{Binding MakeError}" Content="tekita viga (demo)"
                                          Margin="20,0,0,0" Foreground="Firebrick"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="3. Töömaht (simuleeritud päevi iga plaani kohta)" FontWeight="Bold"
                           Margin="0,12,0,0" TextWrapping="Wrap"/>
                <ComboBox ItemsSource="{Binding WorkloadOptions}" SelectedItem="{Binding SelectedDays}"
                          ItemStringFormat="{}{0:N0} päeva"/>

                <TextBlock Text="4. Käivita" FontWeight="Bold" Margin="0,12,0,0"/>
                <Button Content="Käivita järjestikku" Command="{Binding RunSequentialCommand}" Margin="0,5,0,0"/>
                <Button Content="Käivita paralleelselt" Command="{Binding RunParallelCommand}" Margin="0,5,0,0"/>
                <Button Content="Tühista" Command="{Binding CancelCommand}" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Parem pool: olek ja raport -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" TextWrapping="Wrap"/>
                <ProgressBar Height="12" Margin="0,5,0,0" IsIndeterminate="{Binding IsRunning}"/>
                <TextBlock Text="{Binding ElapsedText}" Margin="0,3,0,0"/>

                <TextBlock Text="Raport" FontWeight="Bold" FontSize="14" Margin="0,10,0,0"/>
                <DataGrid ItemsSource="{Binding Report}" AutoGenerateColumns="False" IsReadOnly="True"
                          Height="260" HeadersVisibility="Column" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Loom" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Olek" Binding="{Binding Status}"/>
                        <DataGridTextColumn Header="Tulemus või veateade" Binding="{Binding Result}" Width="*"/>
                        <DataGridTextColumn Header="Kestus" Binding="{Binding DurationText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding TotalText}" FontWeight="Bold" Margin="0,5,0,0"/>

                <TextBlock Text="Režiimide võrdlus" FontWeight="Bold" FontSize="14" Margin="0,15,0,0"/>
                <TextBlock Text="{Binding ComparisonText}" TextWrapping="Wrap"/>

                <TextBlock Margin="0,15,0,0" Foreground="Gray" TextWrapping="Wrap"
                           Text="Arvutus käib taustalõimedes, seega võid samal ajal vahekaardil 'Loomaaed' loomi edasi kasutada."/>
            </StackPanel>
        </Grid>
    </TabItem>
    </TabControl>
</Window>
